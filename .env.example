# Copiar a .env y ajustar. Ver la tabla de variables en README.md

# --- Obligatorias ---
# Acepta postgres://, postgresql:// o postgresql+asyncpg:// (se normaliza sola; ?sslmode=require también)
DATABASE_URL=postgresql+asyncpg://postgres:TU_CLAVE@localhost:5432/metrik
# Mínimo 32 caracteres. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=genera-una-clave-larga-y-aleatoria-de-32-caracteres-o-mas

# --- Opcionales ---
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEBUG=false
# Lista JSON de orígenes permitidos por CORS
# ALLOWED_ORIGINS=["*"]
# ML_MODELS_DIR=ml/modelos

# --- Solo pruebas ---
# TEST_DATABASE_URL=postgresql+asyncpg://usuario:clave@localhost:5432/metrik_test
